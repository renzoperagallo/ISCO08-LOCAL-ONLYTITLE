# Configuracion local. No contiene claves de API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_S
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_GPU=-1
# Numero de peticiones concurrentes del servidor Ollama.
# Debe ser >= MAX_WORKERS. `make ollama-start` lo eleva automaticamente
# a MAX_WORKERS si es menor. Se aplica al reiniciar el servidor.
OLLAMA_NUM_PARALLEL=1
# Binario de Ollama para `make ollama-start`.
# Por defecto usa `ollama` del PATH; descomenta para una ruta propia.
# OLLAMA_BIN=/ruta/a/ollama
# Ruta de modelos de Ollama (opcional).
# OLLAMA_MODELS=/ruta/a/.ollama/models
# Opcionales para reducir VRAM del servidor (se pasan a `make ollama-start`):
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_THINKING=true
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=900
OLLAMA_MAX_RETRIES=2
OLLAMA_CACHE_ENABLED=true

# Embeddings.
# EMBEDDING_DEVICE: cpu | cuda | cuda:N | mps | auto
# cuda requiere PyTorch con CUDA; verifica con `make gpu-check`.
# auto elige cuda si esta disponible; si CUDA falla por falta de VRAM,
# reintenta en cpu.
EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

TOP_K_RETRIEVE=20
TOP_K_PROMPT=10

# Numero de peticiones concurrentes a Ollama (del lado del cliente).
# El servidor debe tener OLLAMA_NUM_PARALLEL >= MAX_WORKERS.
# `make ollama-start` ajusta OLLAMA_NUM_PARALLEL automaticamente.
# Cada slot paralelo multiplica el KV cache y consume VRAM.
# 6-8 GB VRAM: 1 | 12 GB: 2 | 16 GB: 3 | 24 GB: 4-6
# BATCH_SIZE debe ser >= MAX_WORKERS.
MAX_WORKERS=1

DESCRIPTION_CHARS=900
EXAMPLES_PER_CODE=10
CLASSIFICATION_MAX_TOKENS=8192
