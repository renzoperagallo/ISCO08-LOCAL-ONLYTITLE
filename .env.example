# Configuracion local. No contiene claves de API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_S
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_GPU=-1
OLLAMA_THINKING=true
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=900
OLLAMA_MAX_RETRIES=2
OLLAMA_CACHE_ENABLED=true

EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

TOP_K_RETRIEVE=20
TOP_K_PROMPT=10
MAX_WORKERS=1
DESCRIPTION_CHARS=900
EXAMPLES_PER_CODE=10
CLASSIFICATION_MAX_TOKENS=8192
